{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/auth/login",                    "destination": "/api/auth" },
    { "source": "/api/auth/me",                       "destination": "/api/auth" },
    { "source": "/api/members/:id",                   "destination": "/api/members" },
    { "source": "/api/payments/submit-bill",          "destination": "/api/payments" },
    { "source": "/api/payments/verify/:id",           "destination": "/api/payments" },
    { "source": "/api/payments/:id",                  "destination": "/api/payments" },
    { "source": "/api/attendance/check-in",           "destination": "/api/attendance" },
    { "source": "/api/trainers/:id",                  "destination": "/api/trainers" },
    { "source": "/api/expenses/:id",                  "destination": "/api/expenses" },
    { "source": "/api/whatsapp/send",                 "destination": "/api/whatsapp" },
    { "source": "/api/whatsapp/logs",                 "destination": "/api/whatsapp" },
    { "source": "/api/whatsapp/batch-send-unpaid",    "destination": "/api/whatsapp" },
    { "source": "/((?!api/).*)",                      "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/fee-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
