{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/auth/login",                    "destination": "/api/auth?_route=login" },
    { "source": "/api/auth/me",                       "destination": "/api/auth?_route=me" },
    { "source": "/api/stats/history",                 "destination": "/api/stats?_route=history" },
    { "source": "/api/members/:id",                   "destination": "/api/members?_id=:id" },
    { "source": "/api/members/:id/renew",             "destination": "/api/members?_id=:id&_route=renew" },
    { "source": "/api/payments/submit-bill",          "destination": "/api/payments?_route=submit-bill" },
    { "source": "/api/payments/verify/:id",           "destination": "/api/payments?_route=verify&_id=:id" },
    { "source": "/api/payments/:id",                  "destination": "/api/payments?_id=:id" },
    { "source": "/api/attendance/check-in",           "destination": "/api/attendance?_route=check-in" },
    { "source": "/api/trainers/:id",                  "destination": "/api/trainers?_id=:id" },
    { "source": "/api/expenses/:id",                  "destination": "/api/expenses?_id=:id" },
    { "source": "/api/whatsapp/send",                 "destination": "/api/whatsapp?_route=send" },
    { "source": "/api/whatsapp/logs",                 "destination": "/api/whatsapp?_route=logs" },
    { "source": "/api/whatsapp/batch-send-unpaid",    "destination": "/api/whatsapp?_route=batch-send-unpaid" },
    { "source": "/((?!api/).*)",                      "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/fee-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
