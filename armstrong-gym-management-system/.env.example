# ─── DATABASE (required) ───────────────────────────────────────────────────────
#
# Production (Vercel + Neon free tier):
#   Get pooled connection string from https://neon.tech
#   NEON_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Local development (Docker — run: npm run db:up):
#   NEON_DATABASE_URL="postgresql://armstrong:armstrong@localhost:5432/armstrong_gym"

NEON_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── AUTH (required) ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"
ADMIN_EMAIL="admin@armstrong.gym"
# REQUIRED — change before first deployment. Never use 'admin123' in production.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ─── GYM SETTINGS ─────────────────────────────────────────────────────────────
GYM_NAME="Armstrong Gym & Fitness Club"

# ─── CRON (required) ─────────────────────────────────────────────────────────
# REQUIRED — the app will refuse to start/seed without this value.
# Vercel Cron supplies it automatically as: Authorization: Bearer <CRON_SECRET>
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never use a guessable value. Do not commit the real secret to version control.
CRON_SECRET="replace-with-a-random-64-char-hex-string"

# ─── TWILIO WHATSAPP (optional) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS (production) ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development, localhost:5173 / 3000 / 3001 are always allowed automatically.
# Example: ALLOWED_ORIGINS="https://armstrong-gym.vercel.app,https://www.armstronggym.com"
ALLOWED_ORIGINS="https://your-app.vercel.app"

# ─── CLOUDINARY (optional — image hosting) ────────────────────────────────────
# If set, member/trainer photos are uploaded to Cloudinary CDN instead of
# being stored as base64 data-URIs in the database.
# Get free credentials at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── REDIS (optional — stats caching) ────────────────────────────────────────
# Provide a Redis URL to enable 30-second stat caching (reduces DB load).
# Works with any Redis-compatible service: Upstash, Redis Cloud, local Docker.
# Leave blank to disable caching (no-op fallback, zero extra overhead).
# Upstash example: rediss://default:<password>@<host>.upstash.io:6380
REDIS_URL=""

# ─── SENTRY (optional — error monitoring) ─────────────────────────────────────
# Get your DSN at https://sentry.io → Project Settings → Client Keys (DSN)
# Leave blank to disable Sentry entirely (zero overhead, zero errors sent).
SENTRY_DSN=""
# Browser-side DSN — safe to expose publicly (can be same as SENTRY_DSN)
VITE_SENTRY_DSN=""
