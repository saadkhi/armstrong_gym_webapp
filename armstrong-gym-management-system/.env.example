# ─── DATABASE (required) ───────────────────────────────────────────────────────
#
# Production (Vercel + Neon free tier):
#   Get pooled connection string from https://neon.tech
#   NEON_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Local development (Docker — run: npm run db:up):
#   NEON_DATABASE_URL="postgresql://armstrong:armstrong@localhost:5432/armstrong_gym"

NEON_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── AUTH (required) ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"
ADMIN_EMAIL="admin@armstrong.gym"
ADMIN_PASSWORD="admin123"

# ─── GYM SETTINGS ─────────────────────────────────────────────────────────────
GYM_NAME="Armstrong Gym & Fitness Club"

# ─── CRON (required on Vercel for scheduled reminders) ───────────────────────
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-cron-secret"

# ─── TWILIO WHATSAPP (optional) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
